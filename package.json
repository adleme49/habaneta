{
  "name": "habaneta-clients",
  "version": "0.0.0",
  "private": true,
  "description": "Habaneta clients monorepo — web (Vite) and mobile (Expo).",
  "packageManager": "pnpm@10.7.0",
  "scripts": {
    "dev:web": "pnpm --filter @habaneta/web dev",
    "dev:mobile": "pnpm --filter @habaneta/mobile start",
    "build:web": "pnpm --filter @habaneta/web build",
    "build:types": "pnpm --filter @habaneta/api-types build",
    "test:smoke": "pnpm --filter @habaneta/web test:smoke"
  }
}
